{
    "Comment": "GEN AI Orquestation to save analitycs in S3 tables",
    "StartAt": "parserInput",
    "States": {
        "parallelFilterbyTables": {
            "Branches": [
                {
                    "StartAt": "filterCustomEvents",
                    "States": {
                        "filterCustomEvents": {
                            "InputPath": "$.[?(@.body.index == 'custom')]",
                            "Next": "handleCustomItems",
                            "Type": "Pass"
                        },
                        "handleCustomItems": {
                            "End": true,
                            "ItemProcessor": {
                                "StartAt": "parseCustomItem",
                                "States": {
                                    "Send Message to WebSocket Client": {
                                        "End": true,
                                        "Parameters": {
                                            "ApiEndpoint": "gvy669mge1.execute-api.eu-west-1.amazonaws.com",
                                            "AuthType": "IAM_ROLE",
                                            "Method": "POST",
                                            "Path.$": "States.Format('/@connections/{}', $.connectionId)",
                                            "RequestBody": {
                                                "Message.$": "$"
                                            },
                                            "Stage": "pre"
                                        },
                                        "Resource": "arn:aws:states:::apigateway:invoke",
                                        "Type": "Task"
                                    },
                                    "parseCustomItem": {
                                        "Next": "Send Message to WebSocket Client",
                                        "Parameters": {
                                            "body.$": "States.StringToJson($.body.body)",
                                            "connectionId.$": "$.messageAttributes.connectionId.stringValue",
                                            "executionTime.$": "$$.Execution.StartTime",
                                            "messageId.$": "$.messageId"
                                        },
                                        "Type": "Pass"
                                    }
                                }
                            },
                            "ItemsPath": "$",
                            "MaxConcurrency": 100,
                            "Type": "Map"
                        }
                    }
                },
                {
                    "StartAt": "filterNotificationEmail",
                    "States": {
                        "filterNotificationEmail": {
                            "InputPath": "$.[?(@.body.index == 'notification-email')]",
                            "Next": "handleNotificationsEmail",
                            "Type": "Pass"
                        },
                        "handleNotificationsEmail": {
                            "End": true,
                            "ItemProcessor": {
                                "StartAt": "parseNotificationItem",
                                "States": {
                                    "parseNotificationItem": {
                                        "Next": "sendEmail",
                                        "Parameters": {
                                            "body.$": "$.body.body"
                                        },
                                        "Type": "Pass"
                                    },
                                    "sendEmail": {
                                        "End": true,
                                        "Parameters": {
                                            "Destination": {
                                                "ToAddresses.$": "States.Array($.body.to)"
                                            },
                                            "Message": {
                                                "Body": {
                                                    "Html": {
                                                        "Data.$": "$.body.data"
                                                    }
                                                },
                                                "Subject": {
                                                    "Data.$": "$.body.subject"
                                                }
                                            },
                                            "Source.$": "$.body.from"
                                        },
                                        "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail",
                                        "Type": "Task"
                                    }
                                }
                            },
                            "ItemsPath": "$",
                            "MaxConcurrency": 10,
                            "Type": "Map"
                        }
                    }
                },
                {
                    "StartAt": "filterMenuPrompter",
                    "States": {
                        "filterMenuPrompter": {
                            "InputPath": "$.[?(@.body.index == 'gen-prompt-menu')]",
                            "Next": "handlePrompMenuItems",
                            "Type": "Pass"
                        },
                        "handlePrompMenuItems": {
                            "End": true,
                            "ItemProcessor": {
                                "StartAt": "parsePromptMenu",
                                "States": {
                                    "GetConversationHistory": {
                                        "Next": "parallelPromptStorePromp",
                                        "Parameters": {
                                            "ExpressionAttributeValues": {
                                                ":sessionId": {
                                                    "S.$": "$.connectionId"
                                                }
                                            },
                                            "KeyConditionExpression": "sessionId = :sessionId",
                                            "TableName": "sessions-bedrock-pre"
                                        },
                                        "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
                                        "ResultPath": "$.conversationHistory",
                                        "Type": "Task"
                                    },
                                    "Send Message to WebSocket Menu Prompt": {
                                        "End": true,
                                        "Parameters": {
                                            "ApiEndpoint": "gvy669mge1.execute-api.eu-west-1.amazonaws.com",
                                            "AuthType": "IAM_ROLE",
                                            "Method": "POST",
                                            "Path.$": "States.Format('/@connections/{}', $.connectionId)",
                                            "RequestBody": {
                                                "Message.$": "$.genContent.Body.content[0].text"
                                            },
                                            "Stage": "pre"
                                        },
                                        "Resource": "arn:aws:states:::apigateway:invoke",
                                        "Type": "Task"
                                    },
                                    "StoreResponseFromPromp": {
                                        "Next": "Send Message to WebSocket Menu Prompt",
                                        "Parameters": {
                                            "Item": {
                                                "messages": {
                                                    "S.$": "$.genContent.Body.content[0].text"
                                                },
                                                "sessionId": {
                                                    "S.$": "$.connectionId"
                                                },
                                                "timestamp": {
                                                    "S.$": "$$.State.EnteredTime"
                                                },
                                                "ttl": {
                                                    "N.$": "States.JsonToString($.ttl)"
                                                }
                                            },
                                            "TableName": "sessions-bedrock-pre"
                                        },
                                        "Resource": "arn:aws:states:::dynamodb:putItem",
                                        "ResultPath": "$.responseStoreResponse",
                                        "Type": "Task"
                                    },
                                    "choiceMenu": {
                                        "Choices": [
                                            {
                                                "And": [
                                                    {
                                                        "IsPresent": true,
                                                        "Variable": "$.body.menu"
                                                    }
                                                ],
                                                "Next": "getMenuContent"
                                            }
                                        ],
                                        "Default": "GetConversationHistory",
                                        "Type": "Choice"
                                    },
                                    "getMenuContent": {
                                        "Next": "parallelPromptStoreMenu",
                                        "Parameters": {
                                            "Bucket": "gen-ai-content-pre",
                                            "Key.$": "States.Format('{}', $.body.menu)"
                                        },
                                        "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
                                        "ResultPath": "$.menuContent",
                                        "Type": "Task"
                                    },
                                    "parallelPromptStoreMenu": {
                                        "Branches": [
                                            {
                                                "StartAt": "StoreConversationHistory",
                                                "States": {
                                                    "StoreConversationHistory": {
                                                        "End": true,
                                                        "Parameters": {
                                                            "Item": {
                                                                "messages": {
                                                                    "S.$": "$.menuContent.Body"
                                                                },
                                                                "sessionId": {
                                                                    "S.$": "$.connectionId"
                                                                },
                                                                "timestamp": {
                                                                    "S.$": "$$.State.EnteredTime"
                                                                },
                                                                "ttl": {
                                                                    "N.$": "States.JsonToString($.ttl)"
                                                                }
                                                            },
                                                            "TableName": "sessions-bedrock-pre"
                                                        },
                                                        "Resource": "arn:aws:states:::dynamodb:putItem",
                                                        "Type": "Task"
                                                    }
                                                }
                                            },
                                            {
                                                "StartAt": "promtInputMenuBedrock",
                                                "States": {
                                                    "promtInputMenuBedrock": {
                                                        "End": true,
                                                        "Parameters": {
                                                            "Body": {
                                                                "anthropic_version": "bedrock-2023-05-31",
                                                                "max_tokens": 4096,
                                                                "messages": [
                                                                    {
                                                                        "content": [
                                                                            {
                                                                                "text.$": "States.Format('Este es el menu: {}', $.menuContent)",
                                                                                "type": "text"
                                                                            }
                                                                        ],
                                                                        "role": "user"
                                                                    }
                                                                ]
                                                            },
                                                            "ModelId": "anthropic.claude-3-sonnet-20240229-v1:0"
                                                        },
                                                        "Resource": "arn:aws:states:::bedrock:invokeModel",
                                                        "ResultPath": "$.genContent",
                                                        "Type": "Task"
                                                    }
                                                }
                                            }
                                        ],
                                        "Next": "Send Message to WebSocket Menu Prompt",
                                        "OutputPath": "$[1]",
                                        "Type": "Parallel"
                                    },
                                    "parallelPromptStorePromp": {
                                        "Branches": [
                                            {
                                                "StartAt": "StoreConversationPromp",
                                                "States": {
                                                    "StoreConversationPromp": {
                                                        "End": true,
                                                        "Parameters": {
                                                            "Item": {
                                                                "messages": {
                                                                    "S.$": "$.body.prompt"
                                                                },
                                                                "sessionId": {
                                                                    "S.$": "$.connectionId"
                                                                },
                                                                "timestamp": {
                                                                    "S.$": "$$.State.EnteredTime"
                                                                },
                                                                "ttl": {
                                                                    "N.$": "States.JsonToString($.ttl)"
                                                                }
                                                            },
                                                            "TableName": "sessions-bedrock-pre"
                                                        },
                                                        "Resource": "arn:aws:states:::dynamodb:putItem",
                                                        "Type": "Task"
                                                    }
                                                }
                                            },
                                            {
                                                "StartAt": "promtMenuBedrock",
                                                "States": {
                                                    "promtMenuBedrock": {
                                                        "End": true,
                                                        "Parameters": {
                                                            "Body": {
                                                                "anthropic_version": "bedrock-2023-05-31",
                                                                "max_tokens": 500,
                                                                "messages": [
                                                                    {
                                                                        "content": [
                                                                            {
                                                                                "text": "You are a helpful assistant. Remember our conversation.",
                                                                                "type": "text"
                                                                            }
                                                                        ],
                                                                        "role": "user"
                                                                    },
                                                                    {
                                                                        "content": [
                                                                            {
                                                                                "text.$": "States.JsonToString($.conversationHistory.Items)",
                                                                                "type": "text"
                                                                            }
                                                                        ],
                                                                        "role": "assistant"
                                                                    },
                                                                    {
                                                                        "content": [
                                                                            {
                                                                                "text.$": "States.Format('{}', $.body.prompt)",
                                                                                "type": "text"
                                                                            }
                                                                        ],
                                                                        "role": "user"
                                                                    }
                                                                ]
                                                            },
                                                            "ModelId": "anthropic.claude-3-sonnet-20240229-v1:0"
                                                        },
                                                        "Resource": "arn:aws:states:::bedrock:invokeModel",
                                                        "ResultPath": "$.genContent",
                                                        "Type": "Task"
                                                    }
                                                }
                                            }
                                        ],
                                        "Next": "StoreResponseFromPromp",
                                        "OutputPath": "$[1]",
                                        "Type": "Parallel"
                                    },
                                    "parsePromptMenu": {
                                        "Next": "choiceMenu",
                                        "Parameters": {
                                            "body.$": "$.body.body",
                                            "connectionId.$": "$.messageAttributes.connectionId.stringValue",
                                            "executionTime.$": "$$.Execution.StartTime",
                                            "messageId.$": "$.messageId",
                                            "ttl.$": "$.ttl"
                                        },
                                        "Type": "Pass"
                                    }
                                }
                            },
                            "ItemsPath": "$",
                            "MaxConcurrency": 10,
                            "Type": "Map"
                        }
                    }
                },
                {
                    "StartAt": "Pass",
                    "States": {
                        "Pass": {
                            "Type": "Pass",
                            "InputPath": "$.[?(@.body.index == 'gen-prompt-files')]",
                            "Next": "handlePrompFilesItems"
                        },
                        "handlePrompFilesItems": {
                            "Type": "Map",
                            "ItemProcessor": {
                                "ProcessorConfig": {
                                    "Mode": "INLINE"
                                },
                                "StartAt": "StartDocumentTextDetection",
                                "States": {
                                    "StartDocumentTextDetection": {
                                        "Type": "Task",
                                        "Parameters": {
                                            "DocumentLocation": {
                                                "S3Object": {
                                                    "Bucket": "areas-locations",
                                                    "Name": "resumen1.pdf"
                                                }
                                            },
                                            "OutputConfig": {
                                                "S3Bucket": "gen-ai-content-pre",
                                                "S3Prefix": "textract-output/"
                                            }
                                        },
                                        "Resource": "arn:aws:states:::aws-sdk:textract:startDocumentTextDetection",
                                        "ResultPath": "$.textractJob",
                                        "Next": "WaitForJobCompletion"
                                    },
                                    "WaitForJobCompletion": {
                                        "Type": "Wait",
                                        "Seconds": 30,
                                        "Next": "GetDocumentTextDetectionResults"
                                    },
                                    "GetDocumentTextDetectionResults": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:textract:getDocumentTextDetection",
                                        "Parameters": {
                                            "JobId.$": "$.textractJob.JobId",
                                            "MaxResults": 1
                                        },
                                        "ResultPath": "$.textractResults",
                                        "Next": "CheckJobStatus"
                                    },
                                    "CheckJobStatus": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.textractResults.JobStatus",
                                                "StringEquals": "IN_PROGRESS",
                                                "Next": "WaitForJobCompletion"
                                            },
                                            {
                                                "Variable": "$.textractResults.JobStatus",
                                                "StringEquals": "SUCCEEDED",
                                                "Next": "ProcessAllPages"
                                            }
                                        ],
                                        "Default": "JobFailed"
                                    },
                                    "ProcessAllPages": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "TextExtractorFunction",
                                            "Payload": {
                                                "blocks.$": "$.textractResults.Blocks",
                                                "nextToken.$": "$.textractResults.NextToken"
                                            }
                                        },
                                        "ResultPath": "$.currentExtraction",
                                        "Next": "CheckForMorePages"
                                    },
                                    "CheckForMorePages": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.textractResults.NextToken",
                                                "IsPresent": true,
                                                "Next": "GetNextPage"
                                            }
                                        ],
                                        "Default": "CombineResults"
                                    },
                                    "GetNextPage": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:textract:getDocumentTextDetection",
                                        "Parameters": {
                                            "JobId.$": "$.textractJob.JobId",
                                            "NextToken.$": "$.textractResults.NextToken"
                                        },
                                        "ResultPath": "$.textractResults",
                                        "Next": "ProcessAllPages"
                                    },
                                    "CombineResults": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "CombineTextFunction",
                                            "Payload": {
                                                "extractedPages.$": "$.extractedPages"
                                            }
                                        },
                                        "ResultPath": "$.finalText",
                                        "Next": "StoreResults"
                                    },
                                    "StoreResults": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
                                        "Parameters": {
                                            "Bucket.$": "$.outputBucket",
                                            "Key.$": "$.outputKey",
                                            "Body.$": "States.JsonToString($.finalText)"
                                        },
                                        "Next": "Bedrock InvokeModel"
                                    },
                                    "JobFailed": {
                                        "Type": "Fail",
                                        "Cause": "Textract job failed or was canceled",
                                        "Error": "TextractJobFailed"
                                    },
                                    "Bedrock InvokeModel": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::bedrock:invokeModel",
                                        "Parameters": {
                                            "ModelId": "amazon.titan-embed-text-v2:0",
                                            "Body": {
                                                "inputText": "Your text to be embedded",
                                                "dimensions": 1024,
                                                "normalize": true
                                            },
                                            "ContentType": "application/json",
                                            "Accept": "application/json"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            "End": true
                        }
                    }
                }
            ],
            "End": true,
            "Type": "Parallel"
        },
        "parserInput": {
            "ItemProcessor": {
                "ProcessorConfig": {
                    "ExecutionType": "STANDARD",
                    "Mode": "DISTRIBUTED"
                },
                "StartAt": "parser",
                "States": {
                    "parser": {
                        "End": true,
                        "Parameters": {
                            "body.$": "States.StringToJson($.body)",
                            "messageAttributes.$": "$.messageAttributes",
                            "messageId.$": "$.messageId",
                            "ttl.$": "$.expiredAt"
                        },
                        "Type": "Pass"
                    }
                }
            },
            "ItemsPath": "$",
            "MaxConcurrency": 100,
            "Next": "parallelFilterbyTables",
            "Type": "Map"
        }
    }
}