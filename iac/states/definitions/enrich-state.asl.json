{
    "Comment": "A description of my state machine",
    "StartAt": "Pass",
    "States": {
        "Pass": {
            "Type": "Pass",
            "Assign": {
                "currentTime": "{% $now() %}"
            },
            "Next": "toMilis"
        },
        "toMilis": {
            "Type": "Pass",
            "Output": {
                "inmilis": "{% $toMillis($currentTime)  %}",
                "future": "{% $toMillis($currentTime) + 7889400 * 1000 %}"
            },
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}