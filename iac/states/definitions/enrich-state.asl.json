{
    "Comment": "Enrichment State Machine -1",
    "StartAt": "create now timestamp",
    "States": {
        "create now timestamp": {
            "Type": "Pass",
            "Assign": {
                "currentTime": "{% $now() %}"
            },
            "Next": "Mapping"
        },
        "Mapping": {
            "Type": "Map",
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "DISTRIBUTED",
                    "ExecutionType": "EXPRESS"
                },
                "StartAt": "create expiredAt timestamp",
                "States": {
                    "create expiredAt timestamp": {
                        "Type": "Pass",
                        "Output": {
                            "inputPayload": "{% $states.input %}",
                            "expiredAt": "{% $toMillis($currentTime) + 7889400 * 1000 %}"
                        },
                        "End": true
                    }
                }
            },
            "End": true,
            "Label": "Map",
            "MaxConcurrency": 1000,
            "Items": "{% $states.input %}"
        }
    },
    "QueryLanguage": "JSONata"
}