{
    "Comment": "Enrichment State Machine",
    "StartAt": "create now timestamp",
    "States": {
        "create now timestamp": {
            "Type": "Pass",
            "Assign": {
                "currentTime": "{% $now() %}"
            },
            "Next": "create expiredAt timestamp"
        },
        "create expiredAt timestamp": {
            "Type": "Pass",
            "Output": {
                "inputPayload": "{% $states.input %}",
                "expiredAt": "{% $toMillis($currentTime) + 7889400 * 1000 %}"
            },
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}