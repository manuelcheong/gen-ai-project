{
    "Comment": "Enrichment State Machine",
    "StartAt": "Pass",
    "States": {
        "Pass": {
            "Type": "Pass",
            "Assign": {
                "currentTime": "{% $now() %}"
            },
            "Next": "toMilis"
        },
        "toMilis": {
            "Type": "Pass",
            "Output": {
                "inputPayload": "{% $states.input %}",
                "expiredAt": "{% $toMillis($currentTime) + 7889400 * 1000 %}"
            },
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}