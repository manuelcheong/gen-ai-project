{
    "Comment": "Enrichment State Machine 1",
    "StartAt": "create now timestamp",
    "States": {
        "create now timestamp": {
            "Type": "Pass",
            "Assign": {
                "currentTime": "{% $now() %}"
            },
            "Next": "Mapping"
        },
        "Mapping": {
            "Type": "Map",
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "INLINE"
                },
                "StartAt": "create expiredAt timestamp",
                "States": {
                    "create expiredAt timestamp": {
                        "Type": "Pass",
                        "Output": "{% { \"messageId\": $states.input.messageId, \"body\": $states.input.body,\"messageAttributes\": $states.input.messageAttributes,\"expiredAt\": $toMillis($currentTime) + 10800 * 1000} %}",
                        "End": true
                    }
                }
            },
            "End": true,
            "Label": "Map",
            "MaxConcurrency": 1000,
            "Items": "{% $states.input %}"
        }
    },
    "QueryLanguage": "JSONata"
}